# ==========================================================
# Server
# ==========================================================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# ==========================================================
# MongoDB
# ==========================================================
MONGO_URI=mongodb://127.0.0.1:27017/mern_ecommerce

# ==========================================================
# Auth (JWT) - your existing auth system
# ==========================================================
JWT_SECRET=replace_with_a_long_random_string

# ==========================================================
# Razorpay
# ==========================================================
# Get these from https://dashboard.razorpay.com/app/keys
# Start with rzp_test_xxxxx keys, switch to rzp_live_xxxxx for production.
# NEVER commit real keys to source control.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here

# Webhook secret is set separately in the Razorpay Dashboard
# under Settings > Webhooks when you create the webhook endpoint.
# It is NOT the same as your API key secret.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Currency used across the app (Razorpay expects ISO codes)
RAZORPAY_CURRENCY=INR
